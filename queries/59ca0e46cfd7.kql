// Source: https://github.com/SecureWithUmer/CVE-2026-PoCs
// Collected: 2026-07-22
// KQL Library - https://github.com/sivolko/kql-library

let suspicious_keywords = dynamic([
    "ignore previous",
    "ignore above",
    "disregard",
    "override instructions",
    "do not mention",
    "IMPORTANT:",
    "SYSTEM:",
    "id_rsa",
    "credentials",
    "exfiltrate",
    "base64 encode",
    "send to http",
    "curl ",
    "wget ",
    ".env"
]);
let mcp_keywords = dynamic(["mcp", "model-context-protocol", "toolserver"]);
AzureActivity
| where TimeGenerated > ago(30d)
| where OperationNameValue has "write" or OperationNameValue has "create"
| where Properties_d has_any (mcp_keywords)
    or ResourceId has_any (mcp_keywords)
| where Properties_d has_any (suspicious_keywords)
| project
    TimeGenerated,
    Caller,
    CallerIpAddress,
    OperationNameValue,
    ResourceId = _ResourceId,
    SuspiciousProperties = Properties_d
| extend OWASP_Risk = "ASI01 - Agent Goal Hijack"