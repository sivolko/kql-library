// Source: https://github.com/n-mahry/Real-time-threat-Detection-and-Response-with-Sentinel
// Collected: 2026-05-20
// KQL Library - https://github.com/sivolko/kql-library

SecurityEvent
| where EventID == 4625
| project TimeGenerated, EventID, WorkstationName, Computer,
         Account, LogonTypeName, IpAddress
| extend AccountEntity = Account
| extend IpEntity = IpAddress