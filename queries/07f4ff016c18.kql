// Source: https://github.com/Matt-C-G/sentinel-labs
// Collected: 2026-05-30
// KQL Library - https://github.com/sivolko/kql-library

DeviceEvents
| where ActionType == "UserAccountAddedToLocalGroup"
| where AdditionalFields contains "Administrators"
| project TimeGenerated, DeviceName, InitiatingProcessAccountName, TargetAccount