// Source: https://github.com/kkroth0/threat-hunting-ptbr
// Collected: 2026-07-22
// KQL Library - https://github.com/sivolko/kql-library

let lookback = 14d;
let huntTerms = dynamic(["T1059.007", "supply chain", "npm", "cicd", "H103", "injecting", "malicious", "pre-install", "post-install", "scripts", "package.json", "files", "compromised", "packages", "execute", "infostealer", "payloads", "immediately", "upon", "install", "commands", "CI/CD", "powershell", "cmd.exe", "wscript", "cscript", "mshta", "rundll32", "regsvr32", "CurrentVersion\\Run", "Scheduled", "Service", "Registry"]);
union withsource=SourceTable isfuzzy=true
    SecurityEvent,
    WindowsEvent,
    TrendMicro_XDR_OAT_CL,
    TrendMicro_XDR_WORKBENCH_CL
| where TimeGenerated >= ago(lookback)
| extend SearchBlob = tostring(pack_all())
| where SearchBlob has_any (huntTerms)
| extend HuntId = "H103", SourceUrl = "https://github.com/THORCollective/HEARTH/blob/main/Flames/H103.md"
| project TimeGenerated, HuntId, SourceTable, SourceUrl, SearchBlob
| order by TimeGenerated desc