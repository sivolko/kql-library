// Source: https://github.com/THESunnyNguyen/kql-hunting-queries
// Collected: 2026-07-11
// KQL Library - https://github.com/sivolko/kql-library

let lookback = 7d;
let legacyClientHints = dynamic(["IMAP", "POP", "SMTP", "MAPI", "Exchange ActiveSync", "Other clients", "Autodiscover"]);
SigninLogs
| where TimeGenerated >= ago(lookback)
| where ResultType == 0
| where ClientAppUsed in~ (legacyClientHints) or ClientAppUsed has_any (legacyClientHints)
| summarize
    SuccessfulLogons = count(),
    Apps = make_set(AppDisplayName, 20),
    IPAddresses = make_set(IPAddress, 50),
    Countries = make_set(tostring(LocationDetails.countryOrRegion), 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
  by UserPrincipalName, ClientAppUsed
| order by SuccessfulLogons desc
