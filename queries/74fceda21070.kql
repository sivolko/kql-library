// Source: https://github.com/rod-trent/KQLMysteries
// Collected: 2026-05-27
// KQL Library - https://github.com/sivolko/kql-library

let startTime = ago(7d);
let endTime = now();
SecurityEvent
| where TimeGenerated between(startTime .. endTime)
| where AccountType == 'User' and EventID == 4625
| summarize Count = count() by Account
| order by Count desc
| take 10