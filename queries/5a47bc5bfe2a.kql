// Source: https://github.com/sivolko/kql-library
// Collected: 2026-06-24
// KQL Library - https://github.com/sivolko/kql-library

let Win = SecurityEvent
| where EventID == 4625
| summarize Count=count() | extend Service="RDP";

let Lin = Syslog
| where SyslogMessage contains "Failed password"
| summarize Count=count() | extend Service="SSH";

union Win, Lin
| render piechart