// Source: https://github.com/Cybersec120/azure-soc-lab
// Collected: 2026-06-01
// KQL Library - https://github.com/sivolko/kql-library

let DownloadPatterns = dynamic([
    "Invoke-WebRequest", "IWR", "Invoke-RestMethod", "IRM",
    "DownloadString", "DownloadFile", "DownloadData",
    "Start-BitsTransfer", "Net.WebClient",
    "curl ", "wget ", "certutil -urlcache"
]);
SecurityEvent
| where EventID == 4688
| where Process has_any ("powershell.exe", "pwsh.exe", "cmd.exe")
| where CommandLine has_any (DownloadPatterns)
| project
    TimeGenerated,
    Computer,
    Account,
    ParentProcess = ParentProcessName,
    Process,
    CommandLine
| sort by TimeGenerated desc