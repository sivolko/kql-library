// Source: https://github.com/Azure/ausgovcaf-cloudsoe
// Collected: 2026-06-01
// KQL Library - https://github.com/sivolko/kql-library

SecurityEvent 
| where EventID == 5451
| extend ed = parse_xml(EventData).EventData.Data
| mv-apply ed on 
(
    where ed['@Name'] == 'Mode'
    | project Mode = ed['#text']
)
| where Mode == "%%16403"
| project TimeGenerated, Computer, Activity, Mode="Transport"