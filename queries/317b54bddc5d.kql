// Source: https://github.com/THESunnyNguyen/kql-hunting-queries
// Collected: 2026-05-23
// KQL Library - https://github.com/sivolko/kql-library

let lookback = 1d;
let window = 15m;
let minimumAccounts = 8;
let minimumFailures = 20;
IdentityLogonEvents
| where Timestamp >= ago(lookback)
| where ActionType has_any ("Failed", "LogonFailed") or isnotempty(FailureReason)
| summarize
    FailedAttempts = count(),
    TargetedAccounts = dcount(AccountUpn),
    Accounts = make_set(AccountUpn, 50),
    FailureReasons = make_set(FailureReason, 20),
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp)
  by IPAddress, bin(Timestamp, window)
| where TargetedAccounts >= minimumAccounts and FailedAttempts >= minimumFailures
| project FirstSeen, LastSeen, IPAddress, FailedAttempts, TargetedAccounts, Accounts, FailureReasons
| order by TargetedAccounts desc, FailedAttempts desc
