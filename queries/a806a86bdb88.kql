// Source: https://github.com/petitess/kusto
// Collected: 2026-07-23
// KQL Library - https://github.com/sivolko/kql-library

let timerange = 180d;
OfficeActivity
| where TimeGenerated > ago(timerange) and TimeGenerated < ago(7d)
| where OfficeWorkload == "MicrosoftTeams"
| where Operation == "AppInstalled"
| distinct AzureADAppId
| join kind=rightanti (
    OfficeActivity
    | where TimeGenerated > ago (7d)
    | where OfficeWorkload == "MicrosoftTeams"
    | where Operation == "AppInstalled")
    on AzureADAppId
| project AddonName, AzureADAppId