// Source: https://github.com/AndrewAltimit/exploits
// Collected: 2026-05-29
// KQL Library - https://github.com/sivolko/kql-library

Syslog
| where Facility == "kern" or ProcessName == "auditd"
| where SyslogMessage has "syscall=bpf" and SyslogMessage has "a0=0x5"
| extend
    CallerExe  = extract(@'exe="([^"]+)"', 1, SyslogMessage),
    CallerPid  = extract(@' pid=(\d+) ', 1, SyslogMessage),
    AuditUser  = extract(@' auid=(\d+) ', 1, SyslogMessage)
| where not (CallerExe has_any (
    "bpftool", "/usr/bin/tc", "/usr/sbin/tc",
    "cilium", "calico", "datadog", "falco",
    "tetragon", "tracee", "pixie", "beyla"
))
| project TimeGenerated, Computer, CallerExe, CallerPid, AuditUser, SyslogMessage
| order by TimeGenerated desc


// ============================================================================
// Query 2: XDP Attachment via Netlink (Hider Module Attachment)
//
// Rationale: LinkPro attaches its XDP hider to eth0 using a netlink
// RTM_SETLINK + IFLA_XDP message. This triggers a sendmsg syscall to a
// netlink socket from the loader process. Unexpected XDP attachment from
// non-network-management processes is anomalous.
// ============================================================================
DeviceProcessEvents
| where FileName endswith "go" or InitiatingProcessFileName endswith "go"
| join kind=inner (
    DeviceNetworkEvents
    | where LocalPort == 0 and RemotePort == 0
      and ActionType == "NetworkSignatureInspected"
) on DeviceId
| where not (InitiatingProcessFolderPath has_any (
    "/usr/bin/ip", "/sbin/ip", "/opt/cni/", "/usr/lib/systemd/"
))
| project TimeGenerated, DeviceName, InitiatingProcessFileName,
          InitiatingProcessFolderPath, InitiatingProcessCommandLine
| order by TimeGenerated desc


// ============================================================================
// Query 3: Systemd Service Unit Created with systemd-Like Name
//
// Rationale: LinkPro writes a persistence unit to /etc/systemd/system/ with
// a name designed to blend in with core systemd services.
// ============================================================================
DeviceFileEvents
| where FolderPath startswith "/etc/systemd/system/"
    and FileName endswith ".service"
    and ActionType in ("FileCreated", "FileModified")
| where not (InitiatingProcessFileName has_any (
    "dpkg", "apt", "rpm", "dnf", "yum", "zypper", "ansible", "puppet", "chef"
))
| extend
    IsMimicName = FileName matches regex @"^systemd-[a-z]+-[a-z]+d\.service$"
| project TimeGenerated, DeviceName, FileName, FolderPath,
          InitiatingProcessFileName, InitiatingProcessCommandLine, IsMimicName
| order by TimeGenerated desc


// ============================================================================
// Query 4: Outbound Connection Without Corresponding Inbound Record
//
// Rationale: LinkPro's magic-packet activation drops the inbound UDP at XDP
// layer (no conntrack entry, no application log), but the resulting C2 shell
// exfiltrates via an outbound connection. This query looks for hosts with
// unusual outbound-only connection patterns to rare external IPs on TCP 443.
// ============================================================================
DeviceNetworkEvents
| where ActionType == "ConnectionSuccess"
    and RemotePort == 443
    and Direction == "Outbound"
| summarize
    OutboundCount = count(),
    DistinctRemoteIPs = dcount(RemoteIP),
    RemoteIPs = make_set(RemoteIP, 10)
    by DeviceName, bin(TimeGenerated, 1h)
| where DistinctRemoteIPs == 1 and OutboundCount between (1 .. 5)
| join kind=leftanti (
    DeviceNetworkEvents
    | where ActionType == "InboundConnectionAccepted"
    | summarize by DeviceName, bin(TimeGenerated, 1h)
) on DeviceName, TimeGenerated
| project TimeGenerated, DeviceName, OutboundCount, DistinctRemoteIPs, RemoteIPs
| order by TimeGenerated desc


// ============================================================================
// Query 5: Magic-Packet Temporal Correlation (UDP Closed-Port + Outbound HTTPS)
//
// Rationale: The magic-packet is sent to a closed UDP port. While the XDP program
// drops it before the kernel can process it, full-packet capture (if available)
// or IPFIX/NetFlow may record the brief inbound UDP burst. This query correlates
// a brief UDP spike to a non-listening port with a subsequent outbound connection
// within a 30-second window.
// ============================================================================
let UDPProbes = DeviceNetworkEvents
| where Protocol == "Udp"
    and ActionType == "ConnectionFailed"  // Closed port — ICMP unreachable would fire if not dropped
    and RemotePort > 49151
| project ProbTime = TimeGenerated, DeviceName, ProbeRemoteIP = RemoteIP;
let OutboundHTTPS = DeviceNetworkEvents
| where ActionType == "ConnectionSuccess"
    and RemotePort == 443
    and Direction == "Outbound"
| project ConnTime = TimeGenerated, DeviceName, ConnRemoteIP = RemoteIP;
UDPProbes
| join kind=inner OutboundHTTPS on DeviceName
| where ConnTime between (ProbTime .. (ProbTime + 30s))
| project ProbTime, ConnTime, DeviceName, ProbeRemoteIP, ConnRemoteIP
| order by ProbTime desc