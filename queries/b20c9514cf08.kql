// Collected: 2026-05-28
// KQL Library - https://github.com/sivolko/kql-library

AzureActivity
| where OperationNameValue == "MICROSOFT.AUTHORIZATION/LOCKS/DELETE"
| where ActivityStatusValue == "Start"
| project OperationNameValue , ResourceGroup, Caller, CallerIpAddress, TimeGenerated 