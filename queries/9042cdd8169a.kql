// Source: https://github.com/gnarly-cl0s/AZ-500CheatSheet
// Collected: 2026-07-26
// KQL Library - https://github.com/sivolko/kql-library

﻿SigninLogs
| project UserId, IPAddress, Location, SourceSystem, TimeGenerated, UserPrincipalName
| where UserId == 'object-id-of-the-account'
| extend AccountCustomEntity = UserPrincipalName
| extend IPCustomEntity = IPAddress