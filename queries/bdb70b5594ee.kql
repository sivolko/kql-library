// Source: https://github.com/NourKhalil0/homelab-detection
// Collected: 2026-07-07
// KQL Library - https://github.com/sivolko/kql-library

SecurityEvent
| where EventID == 4688
| where Process =~ "powershell.exe"
| where CommandLine has_any ("-EncodedCommand", "-enc ", "-EC ")
| project TimeGenerated, Computer, Account, CommandLine, ParentProcessName
| order by TimeGenerated desc