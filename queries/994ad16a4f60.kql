// Collected: 2026-06-09
// KQL Library - https://github.com/sivolko/kql-library

let baseline = 30d;
let recent = 2d;
let privilegedAccounts = dynamic(["admin1@contoso.com", "admin2@contoso.com"]);
let knownHosts =
  IdentityLogonEvents
  | where Timestamp between (ago(baseline) .. ago(recent))
  | where AccountUpn in~ (privilegedAccounts)
  | summarize by AccountUpn, DeviceName;
IdentityLogonEvents
| where Timestamp >= ago(recent)
| where AccountUpn in~ (privilegedAccounts)
| where ActionType has_any ("Success", "LogonSuccess")
| lookup kind=leftanti knownHosts on AccountUpn, DeviceName
| project Timestamp, AccountUpn, AccountDomain, AccountName, DeviceName, IPAddress, LogonType, Protocol, ActionType
| order by Timestamp desc