// Source: https://github.com/frances-saunders/cybersecurity-portfolio
// Collected: 2026-05-19
// KQL Library - https://github.com/sivolko/kql-library

SecurityEvent
| where EventID == 4624 and LogonType == 3
| where AccountType == "User"
| summarize Attempts = count() by Account, IpAddress, bin(TimeGenerated, 5m)
| where Attempts > 10