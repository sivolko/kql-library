// Source: https://github.com/3ch0p01nt/RedSun_Undefend
// Collected: 2026-07-06
// KQL Library - https://github.com/sivolko/kql-library

DeviceEvents
| where Timestamp > ago(30d)
| where ActionType == "NamedPipeEvent"
| where AdditionalFields has "REDSUN"
| project Timestamp, DeviceName, InitiatingProcessFileName,
          InitiatingProcessCommandLine, AdditionalFields