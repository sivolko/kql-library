// Source: https://github.com/dabbychiu/Purple-Team-Detection-Lab
// Collected: 2026-08-29
// KQL Library - https://github.com/sivolko/kql-library

let TicketReqs = SecurityEvent
    | where EventID == 4769
    | extend ServiceName = extract(@'<Data Name="ServiceName">([^<]+)</Data>', 1, tostring(EventData))
    | extend SrcIp = extract(@'<Data Name="IpAddress">([^<]+)</Data>', 1, tostring(EventData))
    | extend Requester = extract(@'<Data Name="TargetUserName">([^<]+)</Data>', 1, tostring(EventData))
    | where ServiceName !startswith "krbtgt"
    | where ServiceName !endswith "$"
    | where TimeGenerated > ago(2h)
    | project ReqTime=TimeGenerated, ServiceName, SrcIp, Requester;
let Logons = SecurityEvent
    | where EventID == 4624
    | where TimeGenerated > ago(2h)
    | project LogonTime=TimeGenerated, Account=TargetUserName;
TicketReqs
| join kind=leftanti Logons on $left.ServiceName == $right.Account
| summarize
    RoastedNoLogon = dcount(ServiceName),
    Services = make_set(ServiceName, 20),
    Requesters = make_set(Requester, 10)
    by SrcIp, bin(ReqTime, 30m)
| where RoastedNoLogon >= 2
| order by RoastedNoLogon desc