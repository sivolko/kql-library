// Source: https://github.com/SubashGhimire/Hunting-Queries-and-Detection-Rule-Microsoft-Sentinel-Defender
// Collected: 2026-07-15
// KQL Library - https://github.com/sivolko/kql-library

DeviceFileEvents
// Filter for file creation or modification events
| where ActionType in~ ("FileCreated", "FileModified")
// Focus on the NGINX process as the initiator
| where InitiatingProcessFileName in~ ("nginx", "nginx.exe", "systemd-coredump", "apport")
// Match common core dump file names (e.g., core, core.nginx, core.1234)
| where tolower(FileName) matches regex @"^core(\.nginx)?(\.[0-9]+)?$"
| project TimeGenerated, DeviceName, ActionType, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, SHA256

;

//This KQL query is trying to detect suspicious or heavily encoded web requests that may indicate:
//exploit attempts
//obfuscated payloads
//command injection attempts
//WAF bypass techniques
//malicious scanners

CommonSecurityLog
| where isnotempty(RequestURL)
| extend PlusCount = countof(RequestURL, "+")
| extend EncodedCharCount = countof(RequestURL, "%")
| where PlusCount > 50 or EncodedCharCount > 50
| where RequestURL matches regex @"(%[0-9A-Fa-f]{2}){20,}"
| project
    TimeGenerated,
    SourceIP,
    DestinationIP,
    RequestMethod,
    RequestURL,
    PlusCount,
    EncodedCharCount
| order by EncodedCharCount desc

;

//Command-line anomaly hunting (web shell behavior)
DeviceProcessEvents
| where TimeGenerated > ago(90d)
| where InitiatingProcessFileName has "nginx"
| where ProcessCommandLine has_any ("curl","wget","bash -c","sh -c","python -c","nc ")
| project TimeGenerated, DeviceName, FileName, ProcessCommandLine, InitiatingProcessCommandLine

;

//Core: suspicious child processes from nginx 

DeviceProcessEvents
| where TimeGenerated > ago(90d)
| where InitiatingProcessFileName has "nginx"
| where FileName in~ ("bash","sh","python","perl","curl","wget","nc","netcat","powershell","cmd")
| project TimeGenerated, DeviceName, InitiatingProcessFileName, FileName, ProcessCommandLine, InitiatingProcessCommandLine, AccountName