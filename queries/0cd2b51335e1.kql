// Source: https://github.com/chadmcox/Sentinel-and-Defender-Queries
// Collected: 2026-07-13
// KQL Library - https://github.com/sivolko/kql-library

IdentityLogonEvents 
| where Protocol !in ('NTLM','Kerberos')
| where LogonType == 'LDAP cleartext'
| distinct AccountDisplayName, DeviceName, AccountDomain, LogonType