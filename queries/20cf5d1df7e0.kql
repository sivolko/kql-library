// Source: https://github.com/RachelBulmerSec/Cloud-Security-Engineering-Portfolio
// Collected: 2026-05-21
// KQL Library - https://github.com/sivolko/kql-library

DeviceEvents
| where ActionType in ("AsrLsassCredentialTheftAudited", "AsrLsassCredentialTheftBlocked")
| where ProcessCommandLine != "" 
| project Timestamp,
          DeviceName,
          FileName,
          ProcessCommandLine,
          InitiatingAccount = InitiatingProcessAccountName,
          ActionType
| sort by Timestamp desc