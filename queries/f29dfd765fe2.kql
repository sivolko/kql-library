// KQL Library - https://github.com/sivolko/kql-library

AzureActivity
| where OperationNameValue contains "purge"
| where ActivityStatusValue == "Start"
| project TimeGenerated, OperationNameValue, ActivityStatusValue, ResourceGroup, Caller, CallerIpAddress