// Source: https://github.com/kkroth0/threat-hunting-ptbr
// Collected: 2026-07-23
// KQL Library - https://github.com/sivolko/kql-library

let lookback = 7d;
let huntTerms = dynamic(["T1574.001", "defense evasion", "windows", "dll sideloading", "hijack execution flow", "argamal", "ffmpeg", "masquerading", "pirated games", "H178", "trojanized", "ffmpeg.dll", "shipped", "inside", "cracked/pirated", "game", "side-loading", "Argamal", "first", "stage", "legitimate-named", "exports", "powershell", "cmd.exe", "wscript", "cscript", "mshta", "rundll32", "regsvr32", "CurrentVersion\\Run", "Scheduled", "Service", "Registry", "Image File Execution Options", "SilentProcessExit", "Debugger", "Driver", "DLL"]);
union withsource=SourceTable isfuzzy=true
    SecurityEvent,
    WindowsEvent,
    TrendMicro_XDR_OAT_CL,
    TrendMicro_XDR_WORKBENCH_CL
| where TimeGenerated >= ago(lookback)
| extend SearchBlob = tostring(pack_all())
| where SearchBlob has_any (huntTerms)
| extend HuntId = "H178", SourceUrl = "https://github.com/THORCollective/HEARTH/blob/main/Flames/H178.md"
| project TimeGenerated, HuntId, SourceTable, SourceUrl, SearchBlob
| order by TimeGenerated desc