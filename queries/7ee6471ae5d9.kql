// Source: https://github.com/lenoshz/active-directory-security-lab
// Collected: 2026-05-19
// KQL Library - https://github.com/sivolko/kql-library

SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID == 4768
| where ResultCode == "0x0"  // Successful TGT request
| where isnotempty(TicketOptions)  // Ensure Kerberos ticket fields are present
| extend 
    // Use coalesce to handle potential null values in TicketExpirationTime
    TicketExpTime = coalesce(TicketExpirationTime, TimeGenerated),
    TicketLifetimeHours = iff(isnotempty(TicketExpirationTime), 
        datetime_diff('hour', TicketExpirationTime, TimeGenerated), 
        toint(0))
| where TicketLifetimeHours > 10  // Normal TGT lifetime is 10 hours
| project 
    TimeGenerated,
    TargetUserName,
    TargetDomainName,
    IpAddress,
    TicketEncryptionType,
    TicketLifetimeHours,
    TicketExpTime
| extend 
    AlertDescription = strcat("TGT with abnormal lifetime (", TicketLifetimeHours, " hours) for ", TargetUserName),
    AlertSeverity = case(
        TicketLifetimeHours > 720, "Critical",  // > 30 days
        TicketLifetimeHours > 168, "High",       // > 7 days
        "Medium"
    )

